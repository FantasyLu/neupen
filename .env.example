# ======================================
# 环境变量配置示例
# 复制此文件为 .env 并填写你的配置
# ======================================

# ======================================
# API 密钥（至少配置一个提供商）
# ======================================

# Anthropic Claude（claude-opus-4-6 / claude-sonnet-4-6 / claude-haiku-4-5）
# 获取地址：https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek（deepseek-chat / deepseek-reasoner）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 豆包 / 火山引擎 Ark（doubao-pro-32k / doubao-lite-32k）
# 获取地址：https://console.volcengine.com/ark
DOUBAO_API_KEY=your_doubao_api_key_here

# 通义千问 / 阿里云 DashScope（qwen-max / qwen-plus / qwen-turbo）
# 获取地址：https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=your_qwen_api_key_here

# Google Gemini（gemini-2.0-flash / gemini-1.5-pro）
# 获取地址：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ======================================
# 模型配置
# ======================================

# 全局默认模型（可在项目创建时为每个项目单独选择）
# 可选值见 llm.py MODEL_REGISTRY 中的所有 key
DEFAULT_MODEL=claude-opus-4-6

# ======================================
# 数据存储路径（一般无需修改）
# ======================================

DATA_DIR=./data
LANCEDB_DIR=./data/lancedb

# Embedding 模型（用于章节向量化，需支持中文）
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ======================================
# 其他配置
# ======================================

LOG_LEVEL=INFO
